# Server Configuration
PORT=4000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=chat_db
DB_CONNECTION_LIMIT=10

# Firebase Configuration
# Option 1: Path to Firebase Service Account JSON file (recommended for production/cloud)
# FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json

# Option 2: Individual Firebase credentials via environment variables
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Option 3: Local Firestore Emulator (perfect for development and local testing!)
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_PROJECT_ID=chat-backend-dev
